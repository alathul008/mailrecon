# Optional provider credentials
HIBP_API_KEY=
GITHUB_TOKEN=
GITLAB_TOKEN=

# Ollama is local/private only. OLLAMA_BASE_URL must use a host listed in
# OLLAMA_ALLOWED_HOSTS. Add a trusted private Ollama host explicitly when needed.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_ALLOWED_HOSTS=localhost,127.0.0.1,::1
OLLAMA_MODEL=llama3.2:3b
ENABLE_OLLAMA=false

PRIVACY_MODE=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Execution/resource limits
MAX_CONCURRENCY=8
MAX_QUEUE_DEPTH=100
MAX_INVESTIGATIONS_PER_WINDOW=10
INVESTIGATION_RATE_WINDOW_SECONDS=60

# Required to use protected API endpoints. Generate a long random value.
MAILRECON_API_KEY=
